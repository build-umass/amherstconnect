{
  "name": "amherst-connect-firestore-tests",
  "private": true,
  "type": "module",
  "scripts": {
    "test:event-contract": "node --test shared/contracts/event.test.mjs",
    "test:firestore": "firebase emulators:exec --only firestore --project demo-amherst-connect \"node --test tests/firestore.rules.test.mjs\"",
    "typecheck": "npm --prefix apps/mobile run typecheck",
    "db:seed:generate": "node supabase/scripts/generate-seed.mjs",
    "db:seed:check": "node supabase/scripts/generate-seed.mjs --check",
    "test": "npm run test:event-contract && npm run test:firestore && npm --prefix server test",
    "verify": "npm run test:event-contract && npm run test:firestore && npm --prefix apps/mobile run verify && npm --prefix server run verify"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "5.0.2",
    "firebase": "12.12.0",
    "firebase-tools": "15.31.0",
    "supabase": "2.120.0"
  }
}
