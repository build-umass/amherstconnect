
{
  "name": "amherst-connect-firestore-tests",
  "private": true,
  "type": "module",
  "scripts": {
    "test:event-contract": "node --test shared/contracts/event.test.mjs shared/adapters/localist.test.mjs",
    "test:importer": "node --test tests/importer/importer.test.mjs",
    "test:importer:local": "node --test tests/importer/local.integration.mjs",
    "import:events": "node scripts/import-events.mjs",
    "test:firestore": "firebase emulators:exec --only firestore --project demo-amherst-connect \"node --test tests/firestore.rules.test.mjs\"",
    "typecheck": "npm --prefix apps/mobile run typecheck",
    "db:seed:generate": "node supabase/scripts/generate-seed.mjs",
    "db:seed:check": "node supabase/scripts/generate-seed.mjs --check",
    "supabase:start": "supabase start",
    "supabase:start:ci": "supabase start --exclude rest,realtime,storage,functions,studio,mail,analytics,pooler",
    "supabase:reset": "supabase db reset --local",
    "supabase:test": "supabase test db --local",
    "supabase:lint": "supabase db lint --local --schema public --fail-on error",
    "supabase:stop": "supabase stop",
    "supabase:verify": "node scripts/verify-supabase.mjs",
    "test": "npm run test:event-contract && npm run test:importer && npm run test:firestore && npm --prefix server test",
    "verify": "npm run test:event-contract && npm run test:importer && npm run test:firestore && npm --prefix apps/mobile run verify && npm --prefix server run verify && node --test tests/localist.fixtures.test.mjs"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "5.0.2",
    "firebase": "12.12.0",
    "firebase-tools": "15.31.0",
    "supabase": "2.120.0"
  }
}
